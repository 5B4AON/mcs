{
  "hosting": {
    "public": "dist/morse-code-studio/browser",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "{/,/index.html,/ngsw.json,/ngsw-worker.js,/manifest.webmanifest}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
